# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────
# Local:  mongodb://localhost:27017/merboloebook
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/merboloebook
MONGODB_URI=mongodb://localhost:27017/merboloebook

# ── Auth ──────────────────────────────────────────────────
# Generate a real one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ── Stripe (optional; portfolio checkout is simulated) ──
# Leave unset for demo-only installations. Do not use live Stripe credentials.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── CORS ──────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Frontend (Vite only reads VITE_-prefixed vars, from frontend/.env) ──
VITE_API_URL=http://localhost:5000/api

# ── Vercel deployment ─────────────────────────────────────
# On Vercel the browser calls /api on the same site and frontend/api/proxy.js forwards it to the backend.
# Set this in Vercel → Settings → Environment Variables (no rebuild needed to change it):
# BACKEND_URL must be an explicit HTTPS origin (no /api path).
# Use separate backend origins for preview and production.
# BACKEND_URL=https://<your-render-service>.onrender.com
VITE_STRIPE_PUBLISHABLE_KEY=
