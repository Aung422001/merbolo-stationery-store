# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────
# Local:  mongodb://localhost:27017/merboloebook
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/merboloebook
MONGODB_URI=mongodb://localhost:27017/merboloebook

# ── Auth ──────────────────────────────────────────────────
# Generate a real one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ── Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys) ──
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── CORS ──────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Frontend (Vite only reads VITE_-prefixed vars, from frontend/.env) ──
VITE_API_URL=http://localhost:5000/api
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
